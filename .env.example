# Local mode needs no database setup. Node.js 24 stores records in ./data.
PORT=3000
# Production: add a hosted PostgreSQL connection string in Vercel.
# Use your provider's TLS-enabled URL (sslmode=require or verify-full).
DATABASE_URL=
# Optional language-model assistance. Never put these in public/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to the exact production origin, for example https://your-project.vercel.app
APP_ORIGIN=
